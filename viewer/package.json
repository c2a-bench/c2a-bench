{
  "name": "viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local-hf": "node scripts/dev-local-hf.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "postinstall": "node scripts/copy-monaco.mjs",
    "verify:migration": "tsx scripts/verify-migration.ts",
    "pin:release": "tsx scripts/pin-release.ts",
    "publish:hf": "python3 scripts/publish-release.py",
    "verify:hf": "tsx scripts/verify-hf-release.ts",
    "dataset:check": "tsx scripts/dataset-selection.ts",
    "build:pages": "tsx --env-file-if-exists=.env.local scripts/build-pages.ts",
    "smoke:pages": "tsx scripts/smoke-pages.ts",
    "check:tools": "tsc --project tsconfig.tools.json --noEmit",
    "test:data": "tsx --test scripts/data/*.test.ts",
    "test:pages": "tsx --test scripts/pages/*.test.ts",
    "pin:production": "tsx scripts/pin-production.ts && npm run build:landing && npm run build:doc-index",
    "prerender": "tsx scripts/prerender-static.ts",
    "build:landing": "tsx scripts/build-landing.ts",
    "build:doc-index": "tsx scripts/build-doc-index.ts",
    "customer-types": "tsx scripts/customer-types.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@monaco-editor/react": "4.7.0",
    "@tanstack/react-virtual": "3.13.12",
    "class-variance-authority": "0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "1.52.0",
    "monaco-editor": "0.57.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "react-router": "8.4.0",
    "remark-gfm": "4.0.1",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^20",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
